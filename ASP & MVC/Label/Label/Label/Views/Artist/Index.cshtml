@{
    ViewData["Title"] = "Liste des Artistes";
}

<h2 class="mb-4">Liste des artistes</h2>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Genre</th>
            <th>Pays d'origine</th>
            <th>Encore actif ?</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Artist artist in Model)
        {
            <tr>
                <td>@artist.Id</td>
                <td>@artist.Name</td>
                <td>@artist.Genra</td>
                <td>@artist.Country</td>
                <td>@(artist.Active ? "Oui" : "Non")</td>
            </tr>
        }
    </tbody>
</table>
