@{
    ViewData["Title"] = "Liste des Artistes";
}

<h2 class="mb-4">Membres des différents groupes</h2>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Pseudo</th>
            <th>Prénom</th>
            <th>Nom</th>
            <th>Age</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Member member in Model)
        {
            <tr>
                <td>@member.Id</td>
                <td>@member.Pseudo</td>
                <td>
                    <a class="nav-link text-secondary-emphasis" asp-area="" asp-controller="Album" asp-action="ByArtist" asp-route-FirstName=@member.FirstName asp-route-BandId =@member.BandId>@member.FirstName</a>
                </td>
                <td>@member.LastName</td>
                <td>@member.Age</td>
            </tr>
        }
    </tbody>
</table>