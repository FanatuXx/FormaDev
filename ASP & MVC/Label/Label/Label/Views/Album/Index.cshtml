@{
    ViewData["Title"] = "Liste des Albums";
}

<h2 class="mb-4">Liste des albums</h2>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID de l'album</th>
            <th>Titre</th>
            <th>ID de l'artiste</th>
            <th>Année de sortie</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Album album in Model)
        {
            <tr>
                <td>@album.Id</td>
                <td>@album.Title</td>
                <td>@album.ArtistId</td>
                <td>@album.Year</td>
            </tr>
        }
    </tbody>
</table>