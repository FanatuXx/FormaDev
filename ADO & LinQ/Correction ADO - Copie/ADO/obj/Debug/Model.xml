		<Element Type="SqlProcedure" Name="[dbo].[UpdateStudent]">
			<Property Name="BodyScript">
				<Value><![CDATA[
	IF (@sectionID IS NOT NULL)
	BEGIN
		UPDATE Student
		SET SectionID = @sectionID
		WHERE Id = @studentID
	END
	
	IF (@yearResult IS NOT NULL)
